# HuggingFace token (for gated model downloads and Hub push)
HF_TOKEN=

# Weights & Biases API key (optional, for training logging)
WANDB_API_KEY=

# OpenRouter/OpenAI-compatible baseline (optional, for comparison evaluation)
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=qwen/qwen3-coder

# Direct OpenAI fallback
OPENAI_API_KEY=

# vLLM serving configuration
VLLM_HOST=127.0.0.1
# Only 1, true, yes, or on enable public binding. Empty, 0, and false keep it off.
VLLM_ALLOW_PUBLIC_BIND=
VLLM_PORT=8000
# Optional for loopback development; required by docker-compose.production.yml.
VLLM_API_KEY=
MODEL_PATH=./outputs/awq-model
SERVED_MODEL_NAME=qwen2.5-7b-tool-call
TENSOR_PARALLEL=1
MAX_MODEL_LEN=4096
GPU_MEMORY_UTILIZATION=0.90
